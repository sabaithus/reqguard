# Конфигурация переменных окружения для ReqGuard (AI Requirements Validator)
# Скопируйте этот файл в .env и укажите API-ключ выбранного провайдера.
# НИКОГДА не коммитьте файл .env с реальными ключами в Git!

# 1. Google Gemini API (Рекомендуемый бесплатный вариант без карты: https://aistudio.google.com/apikey)
# Поддерживается автоматический fallback по цепочке моделей при лимитах (429/503/404).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest,gemini-3.8-flash,gemma-4-31b-it

# 2. OpenRouter (бесплатные open-weight модели без карты: https://openrouter.ai/keys):
# OPENAI_API_KEY=your_openrouter_api_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openrouter/free
# OPENAI_FALLBACK_MODELS=nvidia/nemotron-3-ultra:free,google/gemma-4-31b-it:free

# 3. Groq (сверхбыстрый бесплатный API без карты: https://console.groq.com/keys):
# OPENAI_API_KEY=your_groq_api_key_here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-120b

# 4. Anthropic Claude API:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# 5. Локальные модели (Ollama / vLLM):
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:14b

# Дополнительные настройки надёжности
LLM_PROVIDER=auto
LLM_TIMEOUT_SEC=90
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0
LLM_THINKING_BUDGET=1536
